global:
  scrape_interval:     15s
  evaluation_interval: 15s

  # Attach these labels to any time series or alerts when communicating with
  # external systems (federation, remote storage, Alertmanager).
  external_labels:
      monitor: '{{ inventory_hostname }}'

# A scrape configuration containing exactly one endpoint to scrape.
scrape_configs:
  - job_name: 'nodeexporter'
    scrape_interval: 5s
    static_configs:
      - targets: ['{{ ansible_host }}:9100']

  - job_name: 'prometheus'
    scrape_interval: 10s
    static_configs:
      - targets: ['{{ ansible_host }}:9090']

{% if enable_monitoring_stack | default(false) %}
  - job_name: 'cadvisor'
    static_configs:
      - targets:
        - '{{ ansible_host }}:8081'

  - job_name: 'speedtest'
    metrics_path: /metrics
    scrape_interval: 15m
    scrape_timeout: 60s
    static_configs:
      - targets:
        - '{{ ansible_host }}:9798'

  - job_name: 'prometheus-router'
    static_configs:
      - targets:
        - '10.100.0.1:9100'

  - job_name: 'homeassistant'
    basic_auth:
      username: admin
      password: admin
    static_configs:
      - targets:
        - 'svr-frigg.jotunheim.onyxnet.lan:9100'

  - job_name: 'TrueNAS-Muninn'
    static_configs:
      - targets:
        - '{{ ansible_host }}:9108'

  - job_name: 'pve-aesir'
    metrics_path: /pve
    params:
      module: [default]
      cluster: ['1']
      node: ['1']
    static_configs:
      - targets:
        - 'svr-aesir1.asgard.onyxnet.lan:9221'
        - 'svr-aesir2.asgard.onyxnet.lan:9221'
        - 'svr-aesir3.asgard.onyxnet.lan:9221'

  - job_name: 'pve-vanir'
    metrics_path: /pve
    params:
      module: [default]
      cluster: ['1']
      node: ['1']
    static_configs:
      - targets:
        - 'svr-vanir1.asgard.onyxnet.lan:9221'
        - 'svr-vanir2.asgard.onyxnet.lan:9221'
        - 'svr-vanir3.asgard.onyxnet.lan:9221'
{% endif %}

{% if enable_pihole_exporter | default(false) %}
  - job_name: 'pihole-exporter'
    scrape_interval: 10s
    static_configs:
      - targets:
        - {{ ansible_host }}:9617
{% endif %}

{% if enable_transmission_exporter | default(false) %}
  - job_name: 'transmission-exporter'
    static_configs:
      - targets:
        - {{ ansible_host }}:19091
{% endif %}